# Azure Voice Live (required)
AZURE_VOICE_LIVE_ENDPOINT=https://your-resource.voice.azure.com/
AZURE_VOICE_LIVE_MODEL=gpt-4o
AZURE_VOICE_LIVE_API_KEY=YOUR_AZURE_API_KEY


# Optional: FastAPI context server - when set, voice chat will only discuss topics from added context
CONTEXT_API_URL=http://localhost:8001
