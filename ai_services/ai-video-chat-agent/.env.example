LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=YOUR_AZURE_API_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.video.azure.com/
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_DEPLOYMENT_GPT4O=gpt-4o
AZURE_DEPLOYMENT_GPT4O_MINI=gpt-4o
AZURE_DEPLOYMENT_TTS=gpt-audio-mini
AZURE_DEPLOYMENT_AUDIO=gpt-audio-mini
VIDEO_QUALITY=fast
DEFAULT_LANGUAGE=en
ENABLE_PARTICLES=true
ENABLE_TRANSITIONS=false
ENABLE_AVATAR=true
ENABLE_BACKGROUND_MUSIC=false
ENABLE_3D_EFFECTS=false
ENABLE_PRACTICE_MODE=true
ENABLE_INTERACTIVE_MODE=true
ENABLE_WEB_SEARCH=false
DEFAULT_DIFFICULTY=beginner